# Copy to .env.local and fill in. Never commit the filled file.
# The inquiry route works without these keys; it returns 503 and points
# the visitor to the fallback email until at least one owner adapter is set.

# Google Sheets append (share the sheet with the service-account email).
# GOOGLE_PRIVATE_KEY may contain literal \n sequences.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Resend owner email and visitor auto-reply.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_OWNER_EMAIL=

# Twilio WhatsApp alert. Values may include the whatsapp: prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
